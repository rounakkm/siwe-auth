# Application Configuration
NEXT_PUBLIC_APP_NAME="SIWE Session Auth"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SIWE Server Configuration
SIWE_DOMAIN="localhost:3000"
SIWE_ORIGIN="http://localhost:3000"
SIWE_CHAIN_ID="1"
SIWE_STATEMENT="Sign in with Ethereum to the application."
NONCE_TTL_SECONDS="300"

# Iron Session Secret (Must be at least 32 characters in production)
SESSION_PASSWORD="replace_with_a_secure_session_password_at_least_32_chars_long"

# Blockchain RPC Configuration (Optional / Extensible)
NEXT_PUBLIC_DEFAULT_CHAIN_ID="1"
